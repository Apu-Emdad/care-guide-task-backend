# Copy to .env and adjust.

# App
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Put your own user, password and cluster host here,
# and end it with the database name. URL-encode special characters in the password.
# Never commit your real .env file.
MONGODB_URI=mongodb+srv://<username>:<password>@care-guide-task.outlyy3.mongodb.net/<database-name>

# Redis (docker compose)
REDIS_HOST=localhost
REDIS_PORT=6381
# Database number 0 to 15. Apps sharing one Redis server must use different numbers.
REDIS_DB=0

# Auth
# Secrets: at least 32 characters each, and different from each other.
# Generate one with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-of-32-plus-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-of-32-plus-characters
# Lifetimes in seconds (900 = 15 minutes, 604800 = 7 days)
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# Web app origin, allowed by CORS to send the refresh cookie
WEB_ORIGIN=http://localhost:5001

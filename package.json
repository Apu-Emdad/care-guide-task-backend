{
  "name": "care-guide-task-backend",
  "version": "0.0.1",
  "description": "Secure notes API: NestJS, MongoDB Atlas, JWT with refresh tokens, roles and aggregations",
  "author": "Apu Emdad",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/check-node.mjs && nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node scripts/check-node.mjs && nest start",
    "start:dev": "node scripts/check-node.mjs && nest start --watch",
    "start:debug": "node scripts/check-node.mjs && nest start --debug --watch",
    "start:prod": "node scripts/check-node.mjs && node dist/main",
    "lint": "oxlint --type-aware src/",
    "typecheck": "tsc --noEmit",
    "db:seed": "node scripts/check-node.mjs && tsx scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "mongoose": "^9.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "dotenv": "^18.0.8",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
